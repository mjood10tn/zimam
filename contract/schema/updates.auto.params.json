{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auto_reboot": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "reboot_time": {
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "type": "string"
    }
  },
  "required": [
    "auto_reboot",
    "enabled"
  ],
  "title": "updates.auto params",
  "type": "object"
}
