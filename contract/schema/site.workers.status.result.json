{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "workers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,15}$",
            "type": "string"
          },
          "instances": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "active": {
                  "type": "string"
                },
                "failing": {
                  "type": "boolean"
                },
                "instance": {
                  "type": "integer"
                },
                "restarts": {
                  "type": "integer"
                },
                "since": {
                  "type": "string"
                },
                "sub": {
                  "type": "string"
                }
              },
              "required": [
                "active",
                "failing",
                "instance",
                "restarts",
                "since",
                "sub"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "instances"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "name",
    "workers"
  ],
  "title": "site.workers.status result",
  "type": "object"
}
