{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "database": {
      "not": {
        "enum": [
          "mysql",
          "sys",
          "information_schema",
          "performance_schema",
          "zimam"
        ]
      },
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "site": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    }
  },
  "required": [
    "database",
    "site"
  ],
  "title": "db.create params",
  "type": "object"
}
