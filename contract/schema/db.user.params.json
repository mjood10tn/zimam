{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "password": {
      "pattern": "^[A-Za-z0-9_-]{24,64}$",
      "type": "string",
      "x-zimam-secret": true
    },
    "site": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    }
  },
  "required": [
    "password",
    "site"
  ],
  "title": "db.user params",
  "type": "object"
}
