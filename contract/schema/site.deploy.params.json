{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "composer": {
      "type": "boolean"
    },
    "keep_releases": {
      "anyOf": [
        {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "script": {
      "maxLength": 65536,
      "pattern": "^[^\\x00]*$",
      "type": "string"
    },
    "trigger": {
      "enum": [
        "manual",
        "webhook",
        "url"
      ],
      "type": "string"
    }
  },
  "required": [
    "composer",
    "name",
    "trigger"
  ],
  "title": "site.deploy params",
  "type": "object"
}
