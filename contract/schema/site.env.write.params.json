{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 65536,
      "pattern": "^[^\\x00]*$",
      "type": "string",
      "x-zimam-secret": true
    },
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    }
  },
  "required": [
    "content",
    "name"
  ],
  "title": "site.env.write params",
  "type": "object"
}
