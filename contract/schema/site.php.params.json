{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "php_version": {
      "enum": [
        "8.2",
        "8.3",
        "8.4",
        "8.5"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "php_version"
  ],
  "title": "site.php params",
  "type": "object"
}
