{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "source": {
      "enum": [
        "site.nginx-access",
        "site.nginx-error",
        "site.php-error",
        "journal.system",
        "journal.kernel",
        "journal.ssh",
        "journal.nginx",
        "journal.zimam-agent",
        "journal.zimam-panel",
        "file.nginx-error",
        "file.certbot",
        "file.apt-history",
        "file.unattended-upgrades",
        "file.zimam-audit",
        "journal.php-8.2",
        "journal.php-8.3",
        "journal.php-8.4",
        "journal.php-8.5"
      ],
      "type": "string"
    }
  },
  "required": [
    "source"
  ],
  "title": "logs.list params",
  "type": "object"
}
