{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "encryption_password": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string",
      "x-zimam-secret": true
    },
    "encryption_salt": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string",
      "x-zimam-secret": true
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "s3": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "access_key_id": {
              "pattern": "^[A-Za-z0-9/+=_.-]{1,256}$",
              "type": "string",
              "x-zimam-secret": true
            },
            "bucket": {
              "not": {
                "pattern": "\\.\\.|\\.-|-\\.|^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
              "type": "string"
            },
            "endpoint": {
              "maxLength": 267,
              "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{1,63}|xn--[a-z0-9-]{0,58}[a-z0-9])(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
              "type": "string"
            },
            "prefix": {
              "maxLength": 128,
              "pattern": "^([a-z0-9_-]+(/[a-z0-9_-]+)*)?$",
              "type": "string"
            },
            "region": {
              "pattern": "^[a-z0-9-]{1,32}$",
              "type": "string"
            },
            "secret_access_key": {
              "pattern": "^[A-Za-z0-9/+=_.-]{1,256}$",
              "type": "string",
              "x-zimam-secret": true
            }
          },
          "required": [
            "access_key_id",
            "bucket",
            "endpoint",
            "region",
            "secret_access_key"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "sftp": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "host": {
              "maxLength": 253,
              "pattern": "^(([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{1,63}|xn--[a-z0-9-]{0,58}[a-z0-9])|[0-9a-f.:]+)$",
              "type": "string"
            },
            "host_key_fingerprint": {
              "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
              "type": "string"
            },
            "path": {
              "maxLength": 128,
              "pattern": "^([a-z0-9_-]+(/[a-z0-9_-]+)*)?$",
              "type": "string"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "user": {
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "user"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "enum": [
        "s3",
        "sftp"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "type"
  ],
  "title": "backup.destination params",
  "type": "object"
}
