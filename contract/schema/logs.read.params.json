{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive": {
      "pattern": "^[a-z0-9-]+\\.log-[0-9]{8}-[0-9]+\\.gz$",
      "type": "string"
    },
    "cursor": {
      "pattern": "^[A-Za-z0-9=;_-]{1,512}$",
      "type": "string"
    },
    "direction": {
      "enum": [
        "back",
        "forward"
      ],
      "type": "string"
    },
    "limit": {
      "maximum": 1000,
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "search": {
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "source": {
      "enum": [
        "site.nginx-access",
        "site.nginx-error",
        "site.php-error",
        "journal.system",
        "journal.kernel",
        "journal.ssh",
        "journal.nginx",
        "journal.zimam-agent",
        "journal.zimam-panel",
        "file.nginx-error",
        "file.certbot",
        "file.apt-history",
        "file.unattended-upgrades",
        "file.zimam-audit",
        "journal.php-8.2",
        "journal.php-8.3",
        "journal.php-8.4",
        "journal.php-8.5"
      ],
      "type": "string"
    }
  },
  "required": [
    "direction",
    "source"
  ],
  "title": "logs.read params",
  "type": "object"
}
