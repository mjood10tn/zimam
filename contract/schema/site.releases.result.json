{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "missing": {
      "items": {
        "pattern": "^[0-9]{14}-[0-9a-f]{7}$",
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "not": {
        "enum": [
          "zimam",
          "panel",
          "default",
          "acme"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "releases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "commit": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9]{14}-[0-9a-f]{7}$",
            "type": "string"
          }
        },
        "required": [
          "active",
          "commit",
          "created",
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "unlisted": {
      "items": {
        "pattern": "^[0-9]{14}-[0-9a-f]{7}$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "missing",
    "name",
    "releases",
    "unlisted"
  ],
  "title": "site.releases result",
  "type": "object"
}
