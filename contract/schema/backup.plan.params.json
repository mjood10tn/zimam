{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "databases": {
      "items": {
        "not": {
          "enum": [
            "mysql",
            "sys",
            "information_schema",
            "performance_schema",
            "zimam"
          ]
        },
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "array"
    },
    "destination": {
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
      "type": "string"
    },
    "panel": {
      "type": "boolean"
    },
    "retention": {
      "additionalProperties": false,
      "properties": {
        "keep_daily": {
          "maximum": 365,
          "minimum": 0,
          "type": "integer"
        },
        "keep_last": {
          "maximum": 365,
          "minimum": 1,
          "type": "integer"
        },
        "keep_monthly": {
          "maximum": 365,
          "minimum": 0,
          "type": "integer"
        },
        "keep_weekly": {
          "maximum": 365,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "keep_last"
      ],
      "type": "object"
    },
    "schedule": {
      "pattern": "^(hourly|daily ([01][0-9]|2[0-3]):[0-5][0-9]|weekly (mon|tue|wed|thu|fri|sat|sun) ([01][0-9]|2[0-3]):[0-5][0-9])$",
      "type": "string"
    },
    "sites": {
      "items": {
        "not": {
          "enum": [
            "zimam",
            "panel",
            "default",
            "acme"
          ]
        },
        "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "destination",
    "id",
    "retention",
    "schedule"
  ],
  "title": "backup.plan params",
  "type": "object"
}
