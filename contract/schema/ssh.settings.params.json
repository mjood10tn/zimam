{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "login_grace_seconds": {
      "maximum": 600,
      "minimum": 10,
      "type": "integer"
    },
    "max_auth_tries": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "password_auth": {
      "type": "boolean"
    },
    "ports": {
      "items": {
        "maximum": 65535,
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "root_login": {
      "enum": [
        "no",
        "prohibit-password"
      ],
      "type": "string"
    }
  },
  "required": [
    "login_grace_seconds",
    "max_auth_tries",
    "password_auth",
    "ports",
    "root_login"
  ],
  "title": "ssh.settings params",
  "type": "object"
}
