# Managed by Zimam. Changes here are overwritten.
{{if .HTTPS -}}
server {
    listen 80;
    listen [::]:80;
    server_name {{safe .Domain}};
{{template "nginx/panel.conf acme"}}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{safe .Domain}};

    ssl_certificate     /etc/letsencrypt/live/zimam-panel/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zimam-panel/privkey.pem;
    include /etc/nginx/zimam/tls.conf;

    # HSTS for this host only, so the owner's other subdomains aren't bound
    # by it, and §9.6's header preset. No location sets headers of its own,
    # so every response gets these.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
{{template "nginx/panel.conf app"}}}
{{else -}}
server {
    listen 80;
    listen [::]:80;
    server_name {{safe .Domain}};
{{template "nginx/panel.conf app"}}}
{{end -}}

{{- /* The ACME location comes first, so renewals work whatever follows. */ -}}
{{define "nginx/panel.conf acme"}}
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/zimam-acme;
        default_type text/plain;
        allow all;
        auth_basic off;
    }
{{end -}}

{{define "nginx/panel.conf app"}}
    root /home/zimam/panel/current/public;
{{- /* zimam owns current and public, and www-data is in every site's
group: a link only works when it and its target have the same owner, so a
compromised panel can't serve a site's files. */}}
    disable_symlinks if_not_owner;
    index index.php index.html;
    autoindex off;
{{template "nginx/panel.conf acme"}}
    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/zimam-panel.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
    }
{{end -}}
