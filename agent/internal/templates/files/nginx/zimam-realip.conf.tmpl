# Managed by Zimam (cloudflare.mode). Changes here are overwritten.
# Nginx takes the visitor's address from CF-Connecting-IP only on a
# connection from one of Cloudflare's ranges, so a direct visitor can't
# forge it (R06-D7).
{{range .Ranges}}set_real_ip_from {{prefix .}};
{{end -}}
real_ip_header CF-Connecting-IP;
real_ip_recursive off;
