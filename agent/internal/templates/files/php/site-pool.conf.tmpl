; Managed by Zimam. Changes here are overwritten.
[zimam-{{safe .Name}}]
user = s_{{safe .Name}}
group = s_{{safe .Name}}
listen = /run/php/zimam-{{safe .Name}}-{{safe .PHPVersion}}.sock
listen.owner = s_{{safe .Name}}
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /home/s_{{safe .Name}}/logs/php-error.log
php_admin_value[sys_temp_dir] = /home/s_{{safe .Name}}/tmp
php_admin_value[upload_tmp_dir] = /home/s_{{safe .Name}}/tmp
php_admin_value[session.save_path] = /home/s_{{safe .Name}}/tmp
{{- if .RestrictToSiteFolder}}
php_admin_value[open_basedir] = /home/s_{{safe .Name}}/site/:/home/s_{{safe .Name}}/tmp/:/home/s_{{safe .Name}}/logs/
{{- end}}
{{- if .BlockRiskyFunctions}}
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec
{{- end}}
