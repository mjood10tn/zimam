# Managed by Zimam (ssh.settings). Changes here are overwritten.
# sshd keeps the first value it reads, and this file sorts before Ubuntu's
# and cloud-init's drop-ins (R06-D4).
PasswordAuthentication {{if .PasswordAuth}}yes{{else}}no{{end}}
PermitRootLogin {{safe .RootLogin}}
{{- range .Ports}}
Port {{.}}
{{- end}}
MaxAuthTries {{.MaxAuthTries}}
LoginGraceTime {{.LoginGraceSeconds}}
