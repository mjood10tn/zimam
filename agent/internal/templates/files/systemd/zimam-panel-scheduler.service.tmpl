# Managed by Zimam. Changes here are overwritten.
[Unit]
Description=Zimam panel scheduler

[Service]
Type=oneshot
User=zimam
Group=zimam
WorkingDirectory=/home/zimam/panel/current
ExecStart=/usr/bin/php{{safe .PanelPHP}} artisan schedule:run
# A hung run would otherwise block every later one.
TimeoutStartSec=10min
