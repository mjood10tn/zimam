# Managed by Zimam. Changes here are overwritten.
[Unit]
Description=Zimam worker horizon of site shop (%i)
PartOf=zimam-site-shop.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=s_shop
Group=s_shop
ExecStart=/bin/bash /home/s_shop/.zimam/workers/horizon.sh
Restart=always
RestartSec=5
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=90
MemoryMax=1024M
MemorySwapMax=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/s_shop
ReadWritePaths=/home/s_shop
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=zimam-site-shop.target
